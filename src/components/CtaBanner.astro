---
/** Repeated call to action. Placed after the modules and after the business case. */
interface Props {
  headline: string;
  text: string;
}

const { headline, text } = Astro.props;
---

<section class="bg-brand-100">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-6 py-14">
    <div>
      <p class="text-2xl font-semibold text-ink-900">{headline}</p>
      <p class="mt-2 text-ink-600">{text}</p>
    </div>
    <a
      href="#kontakt"
      class="rounded-full bg-ink-900 px-7 py-3 font-medium text-white transition-colors hover:bg-ink-800"
    >
      Kostenlos testen
    </a>
  </div>
</section>
