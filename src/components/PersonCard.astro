---
/**
 * Photo left, name and title right. One size for everyone.
 * The photo is a placeholder with initials — swap the inner div for an
 * <Image> once portraits exist and every call site keeps its layout.
 */
interface Props {
  name: string;
  title: string;
}

const { name, title } = Astro.props;

const initials = name
  .split(" ")
  .map((part) => part[0])
  .slice(0, 2)
  .join("");
---

<div class="flex items-center gap-4 rounded-xl bg-ink-900 p-4">
  <div
    aria-hidden="true"
    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-ink-800"
  >
    {initials}
  </div>

  <div class="min-w-0">
    <p class="truncate font-semibold text-white">{name}</p>
    <p class="truncate text-sm text-ink-300">{title}</p>
  </div>
</div>
