---
import { site, legalLinks } from "../data/site";
import LinkedInIcon from "./icons/LinkedInIcon";
import { brand } from "../data/brand";

/**
 * One slim line. Navigation lives in the sticky header, so it is not repeated
 * here — what stays is what people come to the footer for.
 */
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-ink-300">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-4 px-6 py-8 text-sm"
  >
    <img src={brand.wordmarkLight} alt={site.name} class="h-6 w-auto" />

    <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
    <a href={`tel:${site.phoneHref}`} class="hover:text-white">{site.phone}</a>

    <a
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Bonisoft auf LinkedIn"
      class="hover:text-white"
    >
      <LinkedInIcon size={16} />
    </a>

    <ul class="ml-auto flex flex-wrap gap-6">
      {legalLinks.map(({ href, label }) => (
        <li><a href={href} class="hover:text-white">{label}</a></li>
      ))}
    </ul>

    <p class="w-full text-xs text-ink-600">
      © {year} {site.legalName}. Alle Rechte vorbehalten.
    </p>
  </div>
</footer>
