---
import { site, navLinks, legalLinks } from "../data/site";
import LinkedInIcon from "./icons/LinkedInIcon";

const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-ink-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:grid-cols-3">
    <div>
      <p class="text-lg font-semibold text-white">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm">
        Operative Exzellenz für mitarbeiterstarke Unternehmen. Bonisoft verbindet
        Management-Ziele mit dem Arbeitsalltag.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Navigation</p>
      <ul class="mt-3 space-y-2 text-sm">
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class="hover:text-white">{label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Kontakt</p>
      <address class="mt-3 space-y-2 text-sm not-italic">
        <p>{site.legalName}</p>
        <p><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></p>
        <p><a href={`tel:${site.phoneHref}`} class="hover:text-white">{site.phone}</a></p>
      </address>

      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm hover:text-white"
      >
        <LinkedInIcon size={16} />
        LinkedIn
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-xs">
      <p>© {year} {site.legalName}. Alle Rechte vorbehalten.</p>
      <ul class="flex gap-6">
        {legalLinks.map(({ href, label }) => (
          <li><a href={href} class="hover:text-white">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
