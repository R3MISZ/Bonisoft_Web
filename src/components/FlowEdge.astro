---
/**
 * Border highlight for a step card: an outline over the card that brightens
 * from nothing to full and back on its beat, so the cards take turns without
 * anything moving.
 *
 * A plain bordered box, not an SVG. An SVG stretched to the card distorts its
 * corner arcs — wide and flat on a phone, tall and narrow on the desktop grid.
 * A border follows the card's own radius whatever shape the card takes.
 */
interface Props {
  beat: number;
}

const { beat } = Astro.props;
---

<span
  aria-hidden="true"
  class="flow-edge pointer-events-none absolute inset-0 rounded-xl border-[1.5px]"
  style={`--beat: ${beat};`}></span>

<style>
  .flow-edge {
    --cycle: 9s;
    --beats: 5;
    border-color: var(--color-brand-500);
    opacity: 0;
    animation: edge-glow var(--cycle) ease-in-out infinite;
    animation-delay: calc(var(--beat) * var(--cycle) / var(--beats));
  }

  /*
   * Up and down again inside one beat (100 % / --beats = 20 %), so the next
   * card starts only once this one is dark again.
   */
  @keyframes edge-glow {
    0%,
    15%,
    100% {
      opacity: 0;
    }
    7.5% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-edge {
      animation: none;
      opacity: 0;
    }
  }
</style>
