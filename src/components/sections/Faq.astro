---
import { ChevronDown } from "lucide-react";
import { faq } from "../../data/faq";

/** Native <details> — an accordion without a single line of JavaScript. */
---

<section id="faq" class="bg-white py-24">
  <div class="mx-auto max-w-3xl px-6">
    <p class="eyebrow">Häufige Fragen</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
      Antworten, die weiterhelfen.
    </h2>

    <div class="mt-12 divide-y divide-ink-100 border-y border-ink-100">
      {faq.map(({ question, answer, link }) => (
        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between gap-6 font-medium text-ink-900 marker:content-none"
          >
            {question}
            <ChevronDown
              size={18}
              strokeWidth={2}
              aria-hidden="true"
              className="shrink-0 text-brand-600 transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="mt-3 text-ink-600">{answer}</p>
          {link && (
            <a
              href={link.href}
              class="mt-3 inline-block text-sm font-medium text-brand-600 underline decoration-brand-500 underline-offset-2 transition-colors hover:text-brand-500"
            >
              {link.label}
            </a>
          )}
        </details>
      ))}
    </div>
  </div>
</section>
