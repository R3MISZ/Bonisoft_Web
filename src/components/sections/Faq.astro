---
import { faq } from "../../data/faq";

/** Native <details> — an accordion without a single line of JavaScript. */
---

<section id="faq" class="bg-white py-24">
  <div class="mx-auto max-w-3xl px-6">
    <p class="eyebrow">Häufige Fragen</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
      Antworten, die weiterhelfen.
    </h2>

    <div class="mt-12 divide-y divide-ink-100 border-y border-ink-100">
      {faq.map(({ question, answer }) => (
        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between gap-6 font-medium text-ink-900 marker:content-none"
          >
            {question}
            <span
              aria-hidden="true"
              class="shrink-0 text-brand-600 transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-ink-600">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
