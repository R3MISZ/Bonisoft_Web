---
/**
 * Opening section. Purely static: no client directive, no JavaScript shipped.
 * Headline text stays in the component because it appears exactly once.
 */
---

<section id="top" class="relative bg-ink-900 text-white">
  <div class="mx-auto max-w-6xl px-6 pt-40 pb-28">
    <p class="eyebrow">Operative Mitarbeiter-App</p>

    <h1 class="mt-6 max-w-4xl text-4xl leading-tight font-semibold tracking-tight sm:text-5xl md:text-6xl">
      Weniger Sprit, weniger Krankheitstage,{" "}
      <span class="text-brand-500">mehr Prozesstreue.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-ink-300">
      Bonisoft macht operative Leistung messbar, Prozesse transparent und Kommunikation
      wirksam – dort, wo klassische Systeme nicht ankommen.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#kontakt"
        class="rounded-full bg-brand-500 px-7 py-3 font-medium text-ink-900 transition-colors hover:bg-brand-600 hover:text-white"
      >
        Kostenlos testen
      </a>
      <a
        href="#so-funktionierts"
        class="rounded-full border border-white/25 px-7 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        So funktioniert's
      </a>
    </div>
  </div>
</section>
