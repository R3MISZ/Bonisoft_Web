---
/**
 * Opening section. Purely static: no client directive, no JavaScript shipped.
 * Headline text stays in the component because it appears exactly once.
 *
 * Both product shots are cutouts with transparency, so the phone can sit in
 * front of the portal without a frame. Width and height are set on the tags so
 * the browser reserves the space before the files arrive.
 */
const portal = { src: "/product/portal-dashboard.webp", w: 1919, h: 1164 };
const mobile = { src: "/product/mobile-iphone.webp", w: 1600, h: 1164 };
---

<section id="top" class="bg-ink-900 text-white">
  <div
    class="mx-auto grid max-w-6xl gap-14 px-6 pt-36 pb-28 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-10"
  >
    <div>
      <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
        Kosten senken, Ausfälle vermeiden,{" "}
        <span class="text-brand-500">Prozesstreue sichern.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg text-ink-300">
        Für Betriebe mit 100 bis 1.500 Mitarbeitenden in Logistik, Produktion, Handwerk
        und Service. Bonisoft macht operative Leistung messbar – dort, wo klassische
        Systeme nicht ankommen.
      </p>
    </div>

    <div class="relative">
      <img
        src={portal.src}
        width={portal.w}
        height={portal.h}
        alt="Das Bonisoft-Portal mit dem Dashboard einer Führungskraft"
        fetchpriority="high"
        decoding="async"
        class="w-full"
      />

      <img
        src={mobile.src}
        width={mobile.w}
        height={mobile.h}
        alt="Die Bonisoft-App auf dem Smartphone"
        decoding="async"
        class="absolute bottom-0 left-90 w-[52%] translate-y-[12%]"
      />
    </div>
  </div>
</section>
