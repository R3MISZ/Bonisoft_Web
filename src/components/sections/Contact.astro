---
import { Phone } from "lucide-react";
import ContactForm from "../ContactForm.tsx";
import { site } from "../../data/site";

/** Only the form is interactive, so only the form is an island. */
---

<section id="kontakt" class="bg-ink-900 py-24 text-white">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-2 lg:items-start">
    <div>
      <p class="eyebrow">Nächster Schritt</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
        Lassen Sie uns prüfen, wo Ihre Potenziale liegen.
      </h2>
      <p class="mt-5 max-w-lg text-lg text-ink-300">
        Ein kurzes Gespräch reicht, um einzuschätzen, welche Kennzahl bei Ihnen den
        größten Hebel hat. Unverbindlich und kostenlos.
      </p>

      <ol class="mt-10 space-y-4 border-l border-white/10 pl-6 text-sm text-ink-300">
        <li><span class="font-medium text-white">Sie senden das Formular.</span> Vier Felder, mehr brauchen wir nicht.</li>
        <li><span class="font-medium text-white">Wir melden uns innerhalb von 24 Stunden.</span> Maximilian oder Michael, persönlich.</li>
        <li><span class="font-medium text-white">20 Minuten am Telefon.</span> Wir schauen, wo bei Ihnen der größte Hebel liegt – ohne Präsentation und ohne Verpflichtung.</li>
      </ol>
    </div>

    <div>
      <ContactForm client:visible />

      <a
        href={`tel:${site.phoneHref}`}
        class="mt-4 inline-flex items-center gap-2 text-sm text-ink-300 transition-colors hover:text-white"
      >
        <Phone size={16} strokeWidth={1.75} aria-hidden="true" />
        {site.phone}
      </a>
    </div>
  </div>
</section>
