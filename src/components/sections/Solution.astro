---
import FlowLanes from "../FlowLanes.astro";

/**
 * Bridge between the problem and the product. Static, no JavaScript.
 * Carries the central claim of the page: one place for everything, and the
 * points are the reason it gets opened. The lane diagram shows who does what —
 * it used to live in its own section "So funktioniert es".
 */
---

<section id="loesung" class="bg-ink-900 py-24 text-white">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Die Lösung</p>
    <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Eine App für alle Abläufe, Ablagen und Aufgaben.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-300">
      Schichtplan am Aushang, Urlaubsantrag auf Papier, Betriebsvereinbarung im
      Ordner, Aufgaben per Zuruf. Jede Sache hat ihren eigenen Weg – und keiner
      davon erreicht alle.
    </p>
    <p class="mt-5 max-w-2xl text-lg text-ink-300">
      Bonisoft legt alles an einen Ort. Und weil erledigte Aufgaben dort Punkte
      bringen und Punkte Geld sind, wird dieser Ort auch geöffnet.
    </p>

    <div class="mt-14 border-t border-white/10 pt-12">
      <FlowLanes />
    </div>
  </div>
</section>
