---
import ServiceModulePicker from "../ServiceModulePicker.tsx";

/** The service modules, to click through rather than to watch scroll by. */
---

<section id="plattform" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Dienstmodule</p>
    <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Wenn die App schon offen ist.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-600">
      Dienstmodule sind alles, was keine Aufgabe ist: Stempeluhr, Urlaubsantrag,
      Schichtplan, Lohnabrechnung, Betriebsvereinbarung. Aus elf Bausteinen stellen
      Sie zusammen, was Ihre Leute im Alltag brauchen – an derselben Stelle, an der
      sie ohnehin ihre Punkte nachsehen.
    </p>

    <div class="mt-14">
      <ServiceModulePicker client:visible />
    </div>
  </div>
</section>
