---
import { Truck, Factory, HardHat } from "lucide-react";
import { references, type ReferenceIcon } from "../../data/references";

const icons: Record<ReferenceIcon, typeof Truck> = {
  truck: Truck,
  factory: Factory,
  hardhat: HardHat,
};

/**
 * Reference band, same scrolling mechanism as the platform section.
 * Copies per row: enough that one shift never exposes an edge.
 */
const COPIES = 5;
---

<section class="border-b border-ink-100 bg-white py-14">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm text-ink-600">Im Einsatz bei Betrieben wie diesen</p>

    <div class="marquee mt-6">
      <ul class="marquee-track">
        {Array.from({ length: COPIES }, () => references)
          .flat()
          .map((entry, index) => {
            const Icon = icons[entry.icon];

            return (
              <li
                class={`flex aspect-square w-28 shrink-0 flex-col items-center justify-center gap-2 rounded-xl p-3 text-center ${entry.color}`}
                aria-hidden={index >= references.length ? "true" : undefined}
              >
                <Icon size={24} strokeWidth={1.75} className="text-white" aria-hidden="true" />
                <span class="text-sm font-semibold text-white">{entry.name}</span>
              </li>
            );
          })}
      </ul>
    </div>
  </div>
</section>

<style>
  /* The band lives inside the page container and fades at its edges. */
  .marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    /* Five copies: shifting by one copy loops without ever exposing an edge. */
    animation: reference-flow 40s linear infinite;
  }

  @keyframes reference-flow {
    from {
      transform: translateX(-20%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: translateX(-20%);
    }
  }
</style>
