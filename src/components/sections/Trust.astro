---
/**
 * DSGVO and hosting. A buying criterion in German B2B, so it gets its own
 * block — but a flat one: whoever writes at length about data protection
 * sounds like they have something to explain.
 */
const facts = [
  "Hosting in deutschen Rechenzentren",
  "DSGVO-konform, mit AV-Vertrag und Löschkonzept",
  "Kennzahlen für Teams, nicht zur Kontrolle Einzelner",
  "Entwicklung und Betrieb im eigenen Haus",
];
---

<section id="datenschutz" class="border-y border-ink-100 bg-ink-100/50 py-14">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Datenschutz & Betrieb</p>
    <h2 class="mt-3 max-w-3xl text-2xl font-semibold tracking-tight">
      Leistungsdaten sind heikel. Entsprechend gehen wir damit um.
    </h2>

    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-800">
      {facts.map((fact) => (
        <li class="flex items-center gap-2">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>
          {fact}
        </li>
      ))}
    </ul>
  </div>
</section>
