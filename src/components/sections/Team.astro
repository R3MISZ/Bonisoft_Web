---
import PersonCard from "../PersonCard.astro";
import { leadership, teamUnits } from "../../data/team";

/**
 * Org chart over three levels. Connector lines are plain divs and only show
 * from sm upwards — on a phone the unit headings carry the structure.
 */
---

<section id="team" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Wer hinter Bonisoft steht</p>
    <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Entstanden aus der operativen Praxis.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-600">
      Bonisoft entstand nicht am Reißbrett, sondern aus einer Beobachtung: Unternehmen
      investieren in Strategien – aber die Menschen, die sie umsetzen sollen, werden
      nicht mitgenommen.
    </p>

    <div class="mt-14">
      <div class="mx-auto grid max-w-4xl gap-8 sm:grid-cols-2">
        {leadership.map(({ name, title }) => (
          <PersonCard name={name} title={title} />
        ))}
      </div>

      <!-- connector: the 0.5rem offsets account for the 2rem grid gap -->
      <div aria-hidden="true" class="relative mx-auto hidden h-12 max-w-4xl sm:block">
        <span class="absolute top-0 left-1/2 h-6 w-0.5 -translate-x-1/2 bg-ink-300"></span>
        <span class="absolute top-6 right-[calc(25%-0.5rem)] left-[calc(25%-0.5rem)] h-0.5 bg-ink-300"></span>
        <span class="absolute top-6 left-[calc(25%-0.5rem)] h-6 w-0.5 bg-ink-300"></span>
        <span class="absolute top-6 right-[calc(25%-0.5rem)] h-6 w-0.5 bg-ink-300"></span>
      </div>

      <div class="mx-auto mt-10 grid max-w-4xl items-start gap-8 sm:mt-0 sm:grid-cols-2">
        {teamUnits.map((unit) => (
          <div>
            <p class="mb-4 text-center text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">
              {unit.unit}
            </p>
            <div class="space-y-3">
              {unit.members.map(({ name, title }) => (
                <PersonCard name={name} title={title} />
              ))}
            </div>

            {"below" in unit && (
              <>
                <div aria-hidden="true" class="relative mx-auto hidden h-10 sm:block">
                  <span class="absolute top-0 left-1/2 h-10 w-0.5 -translate-x-1/2 bg-ink-300"></span>
                </div>

                <p class="mt-10 mb-4 text-center text-xs font-semibold uppercase tracking-[0.18em] text-brand-600 sm:mt-0">
                  {unit.below.unit}
                </p>
                <div class="space-y-3">
                  {unit.below.members.map(({ name, title }) => (
                    <PersonCard name={name} title={title} />
                  ))}
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
