---
import { industries } from "../../data/industries";
import { modules } from "../../data/modules";

/** Second entry point. Each industry names the modules that carry it. */
const moduleName = (id: string) => modules.find((module) => module.id === id)?.name ?? id;
---

<section id="branchen" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Branchen & Lösungen</p>
    <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Jede Branche hat ihre eigenen Kennzahlen.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-600">
      Die Module bleiben dieselben – was sich unterscheidet, ist die Frage, woran
      Leistung gemessen wird.
    </p>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {industries.map(({ name, text, kpis, moduleIds }) => (
        <article class="flex flex-col rounded-2xl border border-ink-100 p-8">
          <h3 class="text-xl font-semibold text-ink-900">{name}</h3>
          <p class="mt-3 text-ink-600">{text}</p>

          <ul class="mt-6 flex flex-wrap gap-2">
            {kpis.map((kpi) => (
              <li class="rounded-full bg-brand-100 px-3 py-1 text-sm text-ink-800">{kpi}</li>
            ))}
          </ul>

          <p class="mt-auto pt-6 text-sm text-ink-600">
            Relevante Module:
            <span class="font-medium text-ink-800">
              {moduleIds.map(moduleName).join(" · ")}
            </span>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
