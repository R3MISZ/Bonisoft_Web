---
import { reasons } from "../../data/why";

/** Positioning. Moved ahead of the numbers so the reader knows who is talking. */
---

<section id="warum" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="eyebrow">Warum Bonisoft</p>
    <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Nicht noch ein Dashboard.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-600">
      Der Markt hat genug Werkzeuge für die Verwaltung. Was fehlt, ist eines, das bei
      den Menschen ankommt, die die Arbeit machen.
    </p>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-ink-100 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map(({ title, text, proof }) => (
        <article class="bg-white p-8">
          <h3 class="text-lg font-semibold text-ink-900">{title}</h3>
          <p class="mt-3 text-ink-600">{text}</p>
          <p class="mt-5 border-l-2 border-brand-500 pl-4 text-sm font-medium text-ink-800">
            {proof}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
