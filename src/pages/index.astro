---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.tsx";
import Footer from "../components/Footer.astro";

import Hero from "../components/sections/Hero.astro";
import References from "../components/sections/References.astro";
import Reality from "../components/sections/Reality.astro";
import Solution from "../components/sections/Solution.astro";
import ProductDemo from "../components/sections/ProductDemo.astro";
import Platform from "../components/sections/Platform.astro";
import Rewards from "../components/sections/Rewards.astro";
import ActionModules from "../components/sections/ActionModules.astro";
import BusinessCase from "../components/sections/BusinessCase.astro";
import Team from "../components/sections/Team.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";

import { site } from "../data/site";
---

<Layout title={site.title} description={site.description}>
  <Nav client:load />
  <main>
    <Hero />
    <References />
    <Reality />
    <Solution />
    <Rewards />
    <ProductDemo />
    <ActionModules />
    <Platform />
    <BusinessCase />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
